{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"paths": {
			"@shared/*": ["../shared/src/*"]
		}
	},
	"include": [
		"src/**/*",
		"../shared/src/**/*",
		"scripts/fix-duplicates.ts",
		"scripts/migrate-history-zset.ts",
		"scripts/test-fallback.ts",
		"scripts/test-sell-logic.ts"
	],
	"exclude": ["node_modules", "dist"]
}
