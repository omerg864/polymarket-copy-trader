		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/async": "^3.2.25",
		"@types/luxon": "^3.7.1",
		"@types/node": "^20.12.12",
		"@types/ws": "^8.18.1",
		"nodemon": "^3.1.0",
		"ts-node": "^10.9.2",
