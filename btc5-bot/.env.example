# ===========================================
# Polymarket BTC 5-Minute Trading Bot Config
# ===========================================

# Mode: "demo" (paper trading) or "live" (real money)
MODE=demo

# --- Polymarket Credentials (required for live mode) ---
# Your private key (export from wallet or https://reveal.magic.link/polymarket)
PRIVATE_KEY=0x_your_private_key_here

# Your Polymarket profile/funder address (where USDC is held)
FUNDER_ADDRESS=0x_your_funder_address_here

# Signature type: 0 = Browser Wallet (MetaMask, etc.), 1 = Magic/Email Login
SIGNATURE_TYPE=0

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Logging ---
LOG_LEVEL=info

# -------------------------------------------------------
# NOTE: All trading strategy parameters (order sizes,
# thresholds, TP/SL, candle counts, etc.) are now managed
# in MongoDB via the API dashboard — not in env vars.
# -------------------------------------------------------
