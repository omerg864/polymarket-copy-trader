# ===========================================
# Polymarket Bot — API Server Config
# ===========================================

# API PORT
API_PORT=3001

# --- Authentication ---
# Two-tier auth: admin has full control, readonly can only view
ADMIN_PASSWORD=admin_password_here
READONLY_PASSWORD=readonly_password_here

# --- Bot-to-API Communication ---
# Password used by the bot to authorize notifications/requests
API_PASSWORD=your_api_password_here

# --- Telegram Notifications ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MongoDB ---
# Strategy and notification configs are stored in MongoDB.
MONGO_URI=mongodb://localhost:27017/polymarket-bot

# --- Dashboard ---
# Allowed CORS origin for the web dashboard (e.g., your Vercel URL)
CLIENT_URL=http://localhost:5173
