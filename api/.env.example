# ===========================================
# Polymarket Bot — API Server Config
# ===========================================

# Mode: "demo" (paper trading) or "live" (real money)
MODE=demo

# API PORT
API_PORT=3001

# --- Authentication ---
# Two-tier auth: admin has full control, readonly can only view
ADMIN_PASSWORD=changeme
READONLY_PASSWORD=readonly

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MongoDB ---
# Strategy config is stored in MongoDB and cached in Redis.
MONGO_URI=mongodb://localhost:27017/polymarket-bot

# --- Dashboard ---
# Allowed CORS origin for the web dashboard
CLIENT_URL=http://localhost:5173
