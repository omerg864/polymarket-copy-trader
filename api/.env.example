# ===========================================
# Polymarket BTC 5-Minute Trading Bot Config
# ===========================================

# Mode: "demo" (paper trading) or "live" (real money)
MODE=demo

# --- Polymarket Credentials (required for live mode) ---
# Your private key (export from wallet or https://reveal.magic.link/polymarket)
PRIVATE_KEY=0x_your_private_key_here

# Your Polymarket profile/funder address (where USDC is held)
FUNDER_ADDRESS=0x_your_funder_address_here

# Signature type: 0 = Browser Wallet (MetaMask, etc.), 1 = Magic/Email Login
SIGNATURE_TYPE=0

# --- Redis ---
REDIS_URL=redis://localhost:6379
# Milliseconds between TP/SL checks (lower = faster response, default 2000)
RISK_MONITOR_INTERVAL_MS=2000

# --- Trading Strategy ---
# Virtual USDC budget the bot is allowed to access (for both demo and live)
BOT_ALLOWANCE=100

# Dynamic order size in USDC per trade
MIN_ORDER_SIZE=5
MAX_ORDER_SIZE=20

# Entry Guards
# Only enter trades with price >= threshold (e.g. 0.80)
MIN_ENTRY_PRICE=0.80
# Only enter trades after market has been open for X minutes (max 5)
MIN_MARKET_AGE_MINUTES=2.0

# High price trade sizing (bonus multiplier for high-probability entries)
# Bonus scales linearly between threshold and price 1.0
HIGH_PRICE_THRESHOLD=0.90
HIGH_PRICE_MAX_BONUS_PCT=1.0  # +100% (2x size) max bonus at price ~1.0

# Minimum confidence threshold (0-1) to enter a trade
CONFIDENCE_THRESHOLD=0.70

# Take profit percentage (e.g., 0.30 = sell when price rises 30% from entry)
TAKE_PROFIT_PCT=0.30

# Stop loss percentage (e.g., 0.20 = sell when price drops 20% from entry)
STOP_LOSS_PCT=0.20

# Maximum concurrent open trades
MAX_CONCURRENT_TRADES=3

# --- Price Analysis ---
# Number of 1-minute candles to fetch for analysis
CANDLE_COUNT=60

# RSI period
RSI_PERIOD=14

# EMA fast/slow periods
EMA_FAST=9
EMA_SLOW=21

# --- Logging ---
LOG_LEVEL=info
