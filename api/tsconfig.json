{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"@shared/*": ["../shared/src/*"]
		}
	},
	"include": ["src/**/*", "../shared/src/**/*"],
	"exclude": ["node_modules", "dist"]
}
