{
	"name": "polymarket-5-minutes-bot-api",
	"version": "1.8.1",
	"description": "Dashboard API for Polymarket Bot",
	"main": "dist/api/src/index.js",
	"scripts": {
		"start": "node -r tsconfig-paths/register dist/api/src/index.js",
		"dev": "nodemon --watch src --watch ../shared/src --ext ts --exec ts-node -r tsconfig-paths/register src/index.ts",
		"build": "tsc && tsc-alias",
		"vercel-build": "npm run build"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"express-async-handler": "^1.2.0",
		"express-rate-limit": "^8.3.0",
		"ioredis": "^5.4.1",
		"mongoose": "^9.2.4",
		"luxon": "^3.7.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/luxon": "^3.7.1",
		"@types/express": "^4.17.21",
		"@types/express-rate-limit": "^5.1.3",
		"@types/node": "^20.12.12",
		"nodemon": "^3.1.0",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.16",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.4.5"
	}
}
