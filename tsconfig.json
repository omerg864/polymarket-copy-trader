{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@shared/*": ["shared/src/*"]
		}
	},
	"include": ["scripts/**/*.ts", "btc5-bot/src/**/*.ts", "shared/src/**/*.ts"]
}
