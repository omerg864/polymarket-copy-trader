# ===========================================
# Polymarket BTC 5-Minute Trading Bot Config
# ===========================================

# Mode: "demo" (paper trading), "test" (live trading isolated for testing), or "live" (production trading)
MODE=demo

# --- Polymarket Credentials (required for live and test modes) ---
# Your private key (export from wallet or https://reveal.magic.link/polymarket)
PRIVATE_KEY=0x_your_private_key_here

# Your Polymarket profile/funder address (where USDC is held)
FUNDER_ADDRESS=0x_your_funder_address_here

# Signature type: 0 = Browser Wallet (MetaMask, etc.), 1 = Magic/Email Login
SIGNATURE_TYPE=0

# Polygon RPC endpoint for on-chain CTF redemption
# Default: https://polygon-rpc.com (public). Use a paid RPC for reliability.
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Polymarket Builder API (Required for gasless redemptions) ---
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/polymarket-bot

# --- Dashboard API Connection ---
API_URL=http://localhost:3001
API_PASSWORD=your_dashboard_password_here

# --- Logging ---
LOG_LEVEL=info

# -------------------------------------------------------
# NOTE: All trading strategy parameters (order sizes,
# thresholds, TP/SL, candle counts, etc.) are now managed
# in MongoDB via the API dashboard — not in env vars.
# -------------------------------------------------------

# Enable automated CTF redemption in live mode (optional, Polymarket now has native auto-redeem)
ENABLE_LIVE_REDEEM=false
